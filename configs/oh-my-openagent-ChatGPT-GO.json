{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "disabled_hooks": [
    "comment-checker",
    "todo-continuation-enforcer"
  ],
  "disabled_skills": [
    "git-master"
  ],
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": true,
    "planner_enabled": true,
    "replace_plan": false
  },
  "agents": {
    "sisyphus": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4-fast",
          "variant": "medium"
        }
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.4-fast",
      "variant": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.4-fast",
      "variant": "high",
      "fallback_models": [
        {
          "model": "opencode-go/glm-5.1"
        }
      ]
    },
    "librarian": {
      "model": "opencode-go/minimax-m2.7"
    },
    "explore": {
      "model": "opencode-go/minimax-m2.7",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4-mini-fast",
          "variant": "medium"
        }
      ]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.4-fast",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "opencode-go/kimi-k2.6"
        }
      ]
    },
    "prometheus": {
      "model": "openai/gpt-5.4-fast",
      "variant": "high",
      "fallback_models": [
        {
          "model": "opencode-go/glm-5.1"
        }
      ]
    },
    "metis": {
      "model": "openai/gpt-5.4-fast",
      "variant": "high",
      "fallback_models": [
        {
          "model": "opencode-go/glm-5.1"
        }
      ]
    },
    "momus": {
      "model": "openai/gpt-5.4-fast",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "opencode-go/glm-5.1"
        }
      ]
    },
    "atlas": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4-fast",
          "variant": "medium"
        },
        {
          "model": "opencode-go/minimax-m2.7"
        }
      ]
    },
    "sisyphus-junior": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4-fast",
          "variant": "medium"
        },
        {
          "model": "opencode-go/minimax-m2.7"
        }
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "opencode-go/glm-5.1"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.4-fast",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "opencode-go/glm-5.1"
        }
      ]
    },
    "deep": {
      "model": "openai/gpt-5.4-fast",
      "variant": "medium"
    },
    "quick": {
      "model": "openai/gpt-5.4-fast-mini",
      "fallback_models": [
        {
          "model": "opencode-go/minimax-m2.7"
        }
      ]
    },
    "unspecified-low": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "opencode-go/kimi-k2.6"
        },
        {
          "model": "opencode-go/minimax-m2.7"
        }
      ]
    },
    "unspecified-high": {
      "model": "openai/gpt-5.3-codex",
      "variant": "high",
      "fallback_models": [
        {
          "model": "opencode-go/kimi-k2.6"
        },
        {
          "model": "opencode-go/minimax-m2.7"
        }
      ]
    },
    "writing": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        {
          "model": "opencode-go/minimax-m2.7"
        }
      ]
    }
  },
  "experimental": {
    "disable_omo_env": true
  }
}