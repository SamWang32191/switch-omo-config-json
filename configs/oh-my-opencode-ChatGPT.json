{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "claude_code": {
    "mcp": false,
    "commands": false,
    "skills": false,
    "agents": false,
    "hooks": false,
    "plugins": false
  },
  "disabled_hooks": [
    "comment-checker"
  ],
  "disabled_skills": [],
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": true,
    "planner_enabled": true,
    "replace_plan": false
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true,
    "git_env_prefix": "GIT_MASTER=1"
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "ultrawork": {
        "model": "openai/gpt-5.4",
        "variant": "high"
      },
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "hephaestus": {
      "model": "openai/gpt-5.4",
      "variant": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini"
    },
    "explore": {
      "model": "openai/gpt-5.4-mini"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "prometheus": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "metis": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "momus": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "atlas": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "OpenCode-Builder": {
      "model": "opencode-go/minimax-m2.7",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。"
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.4-mini",
      "variant": "medium",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "openai/gpt-5.4",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    },
    "deep": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium"
    },
    "quick": {
      "model": "openai/gpt-5.4-mini"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium"
    },
    "writing": {
      "model": "openai/gpt-5.4",
      "variant": "medium"
    },
    "artistry": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    }
  },
  "experimental": {
    "disable_omo_env": true
  }
}