{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "claude_code": {
    "mcp": false,
    "commands": false,
    "skills": false,
    "agents": false,
    "hooks": false
  },
  "disabled_hooks": [
    "comment-checker"
  ],
  "disabled_skills": [
    "playwright"
  ],
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": true,
    "planner_enabled": true,
    "replace_plan": false
  },
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "librarian": {
      "model": "minimax-coding-plan/MiniMax-M2.5"
    },
    "explore": {
      "model": "minimax-coding-plan/MiniMax-M2.5"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "prometheus": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "metis": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "momus": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "atlas": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "plan": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文。如果需要問問題，請使用 QUESTION TOOL。"
    },
    "OpenCode-Builder": {
      "model": "minimax-coding-plan/MiniMax-M2.5",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文，不能使用簡體中文。如果需要問問題，請使用 QUESTION TOOL。"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "minimax-coding-plan/MiniMax-M2.5"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.3-codex",
      "variant": "xhigh"
    },
    "deep": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium"
    },
    "quick": {
      "model": "minimax-coding-plan/MiniMax-M2.5"
    },
    "unspecified-low": {
      "model": "minimax-coding-plan/MiniMax-M2.5"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium"
    },
    "writing": {
      "model": "minimax-coding-plan/MiniMax-M2.5",
      "prompt_append": "你必須使用繁體中文(zh_TW)回答所有問題。每次回覆都必須是繁體中文，不能使用簡體中文。如果需要問問題，請使用 QUESTION TOOL。"
    }
  }
}